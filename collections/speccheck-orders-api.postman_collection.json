        {
          "id": "e5c05959-3958-4c15-8460-37498a75f960",
          "name": "List Orders",
          "request": {
            "name": "List Orders",
            "description": {
              "content": "Returns orders for a lab, sorted by creation date with the most recent orders first. Supports cursor pagination via `starting_after` / `ending_before` and a `created` date interval filter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "orders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lab",
                  "value": "<string>",
                  "description": "(Required) The ID of the lab for this request."
                },
                {
                  "disabled": false,
                  "key": "account_number",
                  "value": "<string>",
                  "description": "(Required) The lab account number for this request."
                },
                {
                  "disabled": false,
                  "key": "created[gt]",
                  "value": "<integer>",
                  "description": "Return orders created after this Unix timestamp (exclusive)."
                },
                {
                  "disabled": false,
                  "key": "created[gte]",
                  "value": "<integer>",
                  "description": "Return orders created at or after this Unix timestamp (inclusive)."
                },
                {
                  "disabled": false,
                  "key": "created[lt]",
                  "value": "<integer>",
                  "description": "Return orders created before this Unix timestamp (exclusive)."
                },
                {
                  "disabled": false,
                  "key": "created[lte]",
                  "value": "<integer>",
                  "description": "Return orders created at or before this Unix timestamp (inclusive)."
                },
                {
                  "disabled": false,
                  "key": "ending_before",
                  "value": "<string>",
                  "description": "Cursor - an object ID to fetch the previous page."
                },
                {
                  "disabled": false,
                  "key": "starting_after",
                  "value": "<string>",
                  "description": "Cursor - an object ID to fetch the next page."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Number of objects to return (1-100, default 10)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Email address of the acting user. Must exactly match the email used to log in to the SpecCheck Dashboard.",
                "key": "User-Email",
                "value": "<email>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
